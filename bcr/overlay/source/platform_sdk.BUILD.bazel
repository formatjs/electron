load("@electron//electron:source_headers.bzl", "electron_source_headers")
load("@electron_platform_runtime//:profile.bzl", "LIBRARIES")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["usr/include/x86_64-linux-gnu/pci/config.h"])

[cc_import(
    name = "shared_" + str(index),
    shared_library = "@electron_platform_runtime//:" + soname,
) for index, soname in enumerate(LIBRARIES)]

cc_library(
    name = "ffi_headers",
    hdrs = glob(["usr/include/x86_64-linux-gnu/ffi*.h"]),
    strip_include_prefix = "usr/include/x86_64-linux-gnu",
)

cc_library(
    name = "headers",
    hdrs = glob([
        "usr/include/X11/**/*.h",
        "usr/include/GL/**/*.h",
        "usr/include/EGL/**/*.h",
        "usr/include/KHR/**/*.h",
        "usr/include/gtk-3.0/**/*.h",
        "usr/include/gdk-pixbuf-2.0/**/*.h",
        "usr/include/pango-1.0/**/*.h",
        "usr/include/cairo/**/*.h",
        "usr/include/atk-1.0/**/*.h",
        "usr/include/at-spi2-atk/2.0/**/*.h",
        "usr/include/at-spi-2.0/**/*.h",
        "usr/include/dbus-1.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/dbus-1.0/include/**/*.h",
    ]) + [
        "usr/include/gbm.h",
        "usr/include/libudev.h",
    ],
    includes = [
        "usr/include",
        "usr/include/at-spi-2.0",
        "usr/include/at-spi2-atk/2.0",
        "usr/include/atk-1.0",
        "usr/include/cairo",
        "usr/include/dbus-1.0",
        "usr/include/gdk-pixbuf-2.0",
        "usr/include/gtk-3.0",
        "usr/include/pango-1.0",
        "usr/lib/x86_64-linux-gnu/dbus-1.0/include",
    ],
    deps = [
        ":ffi_headers",
        ":glib_headers",
    ],
)

cc_library(
    name = "desktop",
    deps = [":headers"] + [":shared_" + str(index) for index in range(len(LIBRARIES))],
)

electron_source_headers(
    name = "glib_headers",
    deps = [
        "@glib//gio",
        "@glib//glib",
        "@glib//gobject",
    ],
)

_SONAMES = {
    "X11": "libX11.so.6",
    "Xi": "libXi.so.6",
    "Xext": "libXext.so.6",
    "ffi_pic": "libffi.so.7",
    "gbm": "libgbm.so.1",
    "dbus-1": "libdbus-1.so.3",
    "udev": "libudev.so.1",
    "cairo": "libcairo.so.2",
    "harfbuzz": "libharfbuzz.so.0",
    "pango-1.0": "libpango-1.0.so.0",
    "pangocairo-1.0": "libpangocairo-1.0.so.0",
    "atk-1.0": "libatk-1.0.so.0",
    "atk-bridge-2.0": "libatk-bridge-2.0.so.0",
}

_SHARED = {soname: ":shared_" + str(index) for index, soname in enumerate(LIBRARIES)}

[cc_library(
    name = name,
    deps = [
        ":headers",
        _SHARED[soname],
    ],
) for name, soname in _SONAMES.items()]
