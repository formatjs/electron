load("@electron//electron:source_headers.bzl", "electron_source_headers")
load("@electron_platform_runtime//:profile.bzl", "LIBRARIES", "NEEDED")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "usr/lib/x86_64-linux-gnu/libatomic.so.1.2.0",
    "usr/lib/x86_64-linux-gnu/libcairo-gobject.so.2.11600.0",
    "usr/lib/x86_64-linux-gnu/libgdk-3.so.0.2404.20",
    "usr/lib/x86_64-linux-gnu/libgtk-3.so.0.2404.20",
    "usr/lib/x86_64-linux-gnu/libgdk_pixbuf-2.0.so.0.4200.2",
    "usr/lib/x86_64-linux-gnu/libcups.so.2",
    "usr/lib/x86_64-linux-gnu/libxshmfence.so.1.0.0",
    "usr/include/x86_64-linux-gnu/pci/config.h",
    "usr/lib/x86_64-linux-gnu/libasound.so.2.0.0",
])

_SHARED = {soname: ":shared_" + str(index) for index, soname in enumerate(LIBRARIES)}

[cc_import(
    name = "shared_" + str(index),
    shared_library = "@electron_platform_runtime//:" + soname,
    deps = [_SHARED[dependency] for dependency in NEEDED[soname] if dependency in _SHARED],
) for index, soname in enumerate(LIBRARIES)]

cc_library(
    name = "ffi_headers",
    hdrs = glob(["usr/include/x86_64-linux-gnu/ffi*.h"]),
    strip_include_prefix = "usr/include/x86_64-linux-gnu",
)

cc_library(
    name = "va_headers",
    hdrs = glob(["usr/include/va/**/*.h"]),
    strip_include_prefix = "usr/include",
)

cc_library(
    name = "cups_headers",
    hdrs = glob(["usr/include/cups/**/*.h"]),
    includes = ["usr/include"],
)

cc_library(
    name = "headers",
    hdrs = glob([
        "usr/include/alsa/**/*.h",
        "usr/include/libdrm/**/*.h",
        "usr/include/pulse/**/*.h",
        "usr/include/pipewire-0.3/**/*.h",
        "usr/include/spa-0.2/**/*.h",
        "usr/include/sound/**/*.h",
        "usr/include/X11/**/*.h",
        "usr/include/GL/**/*.h",
        "usr/include/EGL/**/*.h",
        "usr/include/KHR/**/*.h",
        "usr/include/gtk-3.0/**/*.h",
        "usr/include/gdk-pixbuf-2.0/**/*.h",
        "usr/include/pango-1.0/**/*.h",
        "usr/include/cairo/**/*.h",
        "usr/include/atk-1.0/**/*.h",
        "usr/include/at-spi2-atk/2.0/**/*.h",
        "usr/include/at-spi-2.0/**/*.h",
        "usr/include/dbus-1.0/**/*.h",
        "usr/lib/x86_64-linux-gnu/dbus-1.0/include/**/*.h",
    ]) + [
        "usr/include/gbm.h",
        "usr/include/libudev.h",
        "usr/include/xf86drm.h",
        "usr/include/xf86drmMode.h",
    ],
    includes = [
        "usr/include",
        "usr/include/at-spi-2.0",
        "usr/include/at-spi2-atk/2.0",
        "usr/include/atk-1.0",
        "usr/include/cairo",
        "usr/include/dbus-1.0",
        "usr/include/gdk-pixbuf-2.0",
        "usr/include/gtk-3.0",
        "usr/include/libdrm",
        "usr/include/pango-1.0",
        "usr/include/pipewire-0.3",
        "usr/include/spa-0.2",
        "usr/lib/x86_64-linux-gnu/dbus-1.0/include",
    ],
    deps = [
        ":ffi_headers",
        ":glib_headers",
    ],
)

cc_library(
    name = "desktop",
    deps = [":headers"] + [":shared_" + str(index) for index in range(len(LIBRARIES))],
)

electron_source_headers(
    name = "glib_headers",
    deps = [
        "@glib//gio",
        "@glib//glib",
        "@glib//gobject",
    ],
)

_SONAMES = {
    "atomic": "libatomic.so.1",
    "cairo-gobject": "libcairo-gobject.so.2",
    "gdk-3": "libgdk-3.so.0",
    "gtk-3": "libgtk-3.so.0",
    "gdk_pixbuf-2.0": "libgdk_pixbuf-2.0.so.0",
    "cups": "libcups.so.2",
    "xshmfence": "libxshmfence.so.1",
    "atspi": "libatspi.so.0",
    "Xcomposite": "libXcomposite.so.1",
    "Xdamage": "libXdamage.so.1",
    "Xfixes": "libXfixes.so.3",
    "Xrandr": "libXrandr.so.2",
    "Xrender": "libXrender.so.1",
    "Xtst": "libXtst.so.6",
    "drm": "libdrm.so.2",
    "asound": "libasound.so.2",
    "X11": "libX11.so.6",
    "Xi": "libXi.so.6",
    "Xext": "libXext.so.6",
    "ffi_pic": "libffi.so.7",
    "gbm": "libgbm.so.1",
    "dbus-1": "libdbus-1.so.3",
    "udev": "libudev.so.1",
    "cairo": "libcairo.so.2",
    "harfbuzz": "libharfbuzz.so.0",
    "pango-1.0": "libpango-1.0.so.0",
    "pangocairo-1.0": "libpangocairo-1.0.so.0",
    "atk-1.0": "libatk-1.0.so.0",
    "atk-bridge-2.0": "libatk-bridge-2.0.so.0",
}

[cc_library(
    name = name,
    deps = [
        ":headers",
        _SHARED[soname],
    ] + ([":cups_headers"] if name == "cups" else []),
) for name, soname in _SONAMES.items()]

cc_library(
    name = "curl_headers",
    hdrs = glob(
        ["usr/include/x86_64-linux-gnu/curl/*.h"],
        allow_empty = False,
    ),
    strip_include_prefix = "usr/include/x86_64-linux-gnu",
)

cc_library(
    name = "gtk_unix_print_headers",
    hdrs = glob(
        ["usr/include/gtk-3.0/unix-print/gtk/**/*.h"],
        allow_empty = False,
    ),
    includes = ["usr/include/gtk-3.0/unix-print"],
    deps = [":headers"],
)
