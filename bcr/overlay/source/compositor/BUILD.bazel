load("@electron_platform_sources//:profile.bzl", PLATFORM_PROFILE = "PROFILE")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["compositor_test.py"])

cc_binary(
    name = "compositor_probe",
    srcs = ["compositor_probe.cc"],
    copts = PLATFORM_PROFILE["libraries"]["//cc:cc"]["copts"],
    dynamic_deps = ["//source/glib:" + name for name in [
        "zlib",
        "glib",
        "gobject",
        "gmodule",
        "gio",
    ]],
    linkstatic = True,
    local_defines = PLATFORM_PROFILE["libraries"]["//cc:cc"]["defines"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "@electron_platform_sources//:compositor",
    ],
)

py_test(
    name = "compositor_test",
    srcs = ["compositor_test.py"],
    args = [
        "$(rootpath :compositor_probe)",
        "$(rootpath @electron_platform_sources//:libEGL.so)",
        "$(rootpath @electron_platform_sources//:vk_swiftshader_icd.json)",
        "$(rootpath @electron_platform_runtime//:libffi.so.7)",
        "$(rootpath //source/glib:glib)",
    ],
    data = [
        ":compositor_probe",
        "//source/glib",
        "//source/glib:runtime",
        "@electron_platform_runtime//:libffi.so.7",
        "@electron_platform_runtime//:libraries",
        "@electron_platform_sources//:libEGL.so",
        "@electron_platform_sources//:runtime",
        "@electron_platform_sources//:vk_swiftshader_icd.json",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
