load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//electron:source_rules.bzl", "electron_buildflags", "electron_fuses_generate", "electron_js2c", "electron_node_config", "electron_node_defines", "electron_original_fs")
load("//electron:v8_rules.bzl", "electron_v8_bytecodes", "electron_v8_torque", "electron_v8_torque_tool")
load("//source/native:electron_buildflags.bzl", "ELECTRON_BUILD_FLAGS")
load("//source/native:fuses_flags.bzl", "DEBUG_FLAGS")
load("//source/native:node_deps_inputs.bzl", "NODE_DEPENDENCIES")
load("//source/native:node_inputs.bzl", "NODE_BUILTIN_INPUTS", "ORIGINAL_FS_INPUTS")
load("//source/native:v8_bytecode_inputs.bzl", "BYTECODE_GENERATOR")
load("//source/native:v8_torque_inputs.bzl", "TORQUE_RUN")
load(":bundles.bzl", "electron_bundles")
load(":probes.bzl", "loop_probes")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "icu_test",
    srcs = ["icu_test.cc"],
    args = ["$(rootpath @electron_icu_sources//:common/icudtl.dat)"],
    copts = ["-std=c++20"],
    data = ["@electron_icu_sources//:common/icudtl.dat"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["@electron_icu_sources//:icu"],
)

alias(
    name = "icu",
    actual = "@electron_icu_sources//:icu",
)

filegroup(
    name = "icu_libraries",
    srcs = [
        "@electron_icu_sources//:icui18n",
        "@electron_icu_sources//:icuuc_private",
    ],
)

electron_v8_bytecodes(
    name = "v8_bytecodes",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

electron_v8_bytecodes(
    name = "v8_bytecodes_repeat",
    testonly = True,
    output_subdir = "output with spaces",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_library(
    name = "v8_bytecode_headers",
    hdrs = [":v8_bytecodes"],
    strip_include_prefix = "v8_bytecodes",
)

cc_test(
    name = "v8_bytecodes_test",
    srcs = ["v8_bytecodes_test.cc"],
    args = [
        "$(rootpath :v8_bytecodes)",
        "$(rootpath :v8_bytecodes_repeat)",
    ],
    copts = BYTECODE_GENERATOR["copts"],
    data = [
        ":v8_bytecodes",
        ":v8_bytecodes_repeat",
    ],
    local_defines = BYTECODE_GENERATOR["defines"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":v8_bytecode_headers",
        "@electron_v8_sources//:bytecode_generator_support",
    ],
)

electron_v8_torque(
    name = "v8_torque",
    srcs = {"@electron_v8_sources//:" + path: path for path in TORQUE_RUN["sources"]},
    out_files = TORQUE_RUN["outputs"],
    source_order = TORQUE_RUN["sources"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    verify_reproducible = True,
)

filegroup(
    name = "v8_torque_manifest",
    srcs = [":v8_torque"],
    output_group = "manifest",
)

electron_v8_torque_tool(name = "v8_torque_tool")

electron_js2c(
    name = "embedder_javascript",
    srcs = {"builtin.js": "lib/electron/builtin.js"},
)

exports_files([
    "icu.BUILD.bazel",
    "icu_rules.bzl",
    "node_deps.bzl",
    "v8.BUILD.bazel",
    "node.BUILD.bazel",
    "uv_sources.bzl",
    "upstream_pins.json",
    "boringssl-electron.patch",
    "patch_fingerprints.json",
])

alias(
    name = "electron",
    actual = "@electron//:sources",
)

alias(
    name = "node",
    actual = "@electron_node_sources//:sources",
)

alias(
    name = "node_libuv",
    actual = "@electron_node_sources//:libuv",
)

alias(
    name = "node_dependencies",
    actual = "@electron_node_sources//:node_deps",
)

cc_library(
    name = "node_resource_fixture",
    testonly = True,
    srcs = ["node_resource_fixture.S"],
    linkstatic = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_test(
    name = "node_dependencies_test",
    srcs = ["node_dependencies_test.cc"],
    copts = [
        "-std=c++20",
        "-fno-exceptions",
    ],
    linkopts = ["-lm"],
    local_defines = NODE_DEPENDENCIES["ada"]["defines"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [":node_resource_fixture"] + ["@electron_node_sources//:node_deps_" + library for library in [
        "ada",
        "cares",
        "histogram",
        "llhttp",
        "nbytes",
        "ncrypto",
        "nghttp2",
        "postject",
        "simdjson",
        "sqlite",
        "uvwasi",
    ]],
)

cc_test(
    name = "loop_interrupt_test",
    srcs = ["loop_interrupt_test.c"],
    deps = [":node_libuv"],
)

loop_probes()

# Materialize patch provenance without analyzing the full source file inventory.
alias(
    name = "chromium_patches",
    actual = "@electron_chromium_sources//:electron_patches.json",
)

alias(
    name = "v8_patches",
    actual = "@electron_v8_sources//:electron_patches.json",
)

electron_fuses_generate(
    name = "fuses_generated",
    debug_flags = DEBUG_FLAGS,
)

filegroup(
    name = "fuses_sources",
    srcs = [":fuses_generated"],
    output_group = "sources",
)

filegroup(
    name = "fuses_headers",
    srcs = [":fuses_generated"],
    output_group = "headers",
)

cc_library(
    name = "electron_fuses",
    srcs = [":fuses_sources"],
    hdrs = [":fuses_headers"],
    includes = ["fuses_generated"],
    local_defines = ["NDEBUG=1"],
    deps = ["@electron_chromium_sources//:fuse_base_headers"],
)

cc_test(
    name = "fuses_test",
    srcs = ["fuses_test.cc"],
    deps = [":electron_fuses"],
)

cc_test(
    name = "crypto_compat_test",
    srcs = ["crypto_compat_test.cc"],
    deps = ["@electron_boringssl_sources//:ssl"],
)

filegroup(
    name = "dependency_patches",
    srcs = [
        "@electron_boringssl_sources//:LICENSE",
        "@electron_devtools_frontend_sources//:source_anchor",
        "@electron_ffmpeg_sources//:source_anchor",
        "@electron_mantle_sources//:source_anchor",
        "@electron_nan_sources//:source_anchor",
        "@electron_perfetto_sources//:source_anchor",
        "@electron_reactiveobjc_sources//:source_anchor",
        "@electron_reclient_configs_sources//:source_anchor",
        "@electron_sqlite_sources//:source_anchor",
        "@electron_squirrel_mac_sources//:source_anchor",
        "@electron_webrtc_sources//:source_anchor",
    ],
)

electron_node_defines(name = "node_defines")

electron_buildflags(
    name = "electron_buildflags",
    flags = ELECTRON_BUILD_FLAGS,
)

electron_bundles()

cc_test(
    name = "v8_tasks_test",
    srcs = ["v8_tasks_test.cc"],
    copts = [
        "-std=c++20",
        "-fno-exceptions",
        "-fno-rtti",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = ["@electron_v8_sources//:platform_tasks"],
)

electron_original_fs(
    name = "node_original_fs",
    srcs = {"@electron_node_sources//:" + path: path for path in ORIGINAL_FS_INPUTS},
)

electron_node_config(
    name = "node_config",
    settings = "//source/native:node_config_linux_amd64.json",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//tests:__pkg__"],
)

electron_js2c(
    name = "node_javascript",
    srcs = {("@electron_node_sources//deps/v8/tools:" + path.removeprefix("deps/v8/tools/") if path.startswith("deps/v8/tools/") else "@electron_node_sources//:" + path): path for path in NODE_BUILTIN_INPUTS},
    config = ":node_config",
    original_fs = ":node_original_fs",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = [
        "//:__pkg__",
        "//tests:__pkg__",
    ],
)

cc_test(
    name = "node_defines_test",
    srcs = [
        "node_defines_test.cc",
        ":node_defines",
    ],
    includes = ["node_defines"],
)
