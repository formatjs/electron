electron_source_action(
    name = "beta_version_args",
    srcs = {
        "@electron//:script/generate-version-json.js": "electron/script/generate-version-json.js",
        "@electron//:package.json": "electron/package.json",
        "@electron//:yarn.lock": "electron/yarn.lock",
        "@electron_chromium_sources//:third_party/node/node.py": "third_party/node/node.py",
    },
    args = [
        "../../electron/script/generate-version-json.js",
        "beta/electron_version.args",
        "40.2.1-beta.3",
    ],
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    logical_outputs = ["beta/electron_version.args"],
    mapped_source_groups = _VERSION_ACTION["mapped_source_groups"],
    out_files = ["beta/electron_version.args"],
    script = "third_party/node/node.py",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tools = {"@electron_chromium_node_tool//:node-linux-x64/bin/node": "third_party/node/linux/node-linux-x64/bin/node"},
)

[electron_source_action(
    name = "beta_version_" + name,
    srcs = {
        "@electron//:build/generate-template.py": "electron/build/generate-template.py",
        "@electron//:build/templates/" + template: "electron/build/templates/" + template,
        ":beta_version_args": "out/bazel-import/beta/electron_version.args",
    },
    args = [
        "../../electron/build/templates/" + template,
        "beta/" + output,
        "beta/electron_version.args",
    ],
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    logical_outputs = ["beta/" + output],
    out_files = ["beta/" + output],
    script = "electron/build/generate-template.py",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
) for name, template, output in [
    ("header", "electron_version.tmpl", "electron_version.h"),
    ("resource", "electron_rc.tmpl", "electron.rc"),
]]

