load("@electron_platform_runtime//:profile.bzl", "COMMON_LICENSES", "COPYRIGHTS", "LIBRARIES")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_python//python:defs.bzl", "py_test")
load("//electron:artifact_file.bzl", "electron_artifact_file")
load("//electron:node_project.bzl", "electron_node_project")
load("//electron:runtime_archive.bzl", "electron_runtime_archive")
load("//electron:source_action.bzl", "electron_source_action")
load("//source/native:default_app_inputs.bzl", "DEFAULT_APP")
load("//source/native:runtime_files.bzl", "RUNTIME_FILES")
load("//source/native:runtime_metadata.bzl", "RUNTIME_METADATA")

package(default_visibility = ["//visibility:public"])

_COMPATIBLE = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_NATIVE_LIBRARIES = {
    "libz.so.1": "//source/glib:zlib",
    "libglib-2.0.so.0": "//source/glib:glib",
    "libgobject-2.0.so.0": "//source/glib:gobject",
    "libgmodule-2.0.so.0": "//source/glib:gmodule",
    "libgio-2.0.so.0": "//source/glib:gio",
}

_NATIVE_LIBRARIES.update({"lib" + name + ".so": "@nspr//:lib" + name + ".so" for name in [
    "nspr4",
    "plc4",
    "plds4",
]})

_NATIVE_LIBRARIES.update({"lib" + name + ".so": "@nss//:lib" + name + ".so" for name in [
    "freebl3",
    "freeblpriv3",
    "nss3",
    "nssckbi",
    "nssdbm3",
    "nssutil3",
    "smime3",
    "softokn3",
    "ssl3",
]})

_NSS_INTEGRITY_MODULES = ["lib" + name + ".so" for name in [
    "freebl3",
    "freeblpriv3",
    "nssdbm3",
    "softokn3",
]]

_LIBRARIES = {"@electron_platform_runtime//:" + name: name for name in LIBRARIES if name not in _NATIVE_LIBRARIES}

_LIBRARIES.update({label: name for name, label in _NATIVE_LIBRARIES.items()})

_LIBRARIES["@electron_platform_pciutils//:libpci.so.3"] = "libpci.so.3"

_HOST_ABI = [
    "ld-linux-x86-64.so.2",
    "libc.so.6",
    "libdl.so.2",
    "libgcc_s.so.1",
    "libm.so.6",
    "libpthread.so.0",
    "libresolv.so.2",
    "librt.so.1",
    "libstdc++.so.6",
    "libutil.so.1",
]

_FILES = {label: path for path, label in RUNTIME_FILES.items()}

_FILES.update({"@electron_platform_runtime//:licenses/" + name: "licenses/debian/" + name + ".copyright" for name in COPYRIGHTS})

_FILES.update({"@electron_platform_runtime//:licenses/common/" + name: "licenses/common/" + name for name in COMMON_LICENSES})

_FILES.update({
    "//:MODULE.bazel": "licenses/native/MODULE.bazel",
    "//source:upstream_pins.json": "licenses/native/upstream_pins.json",
    "//source/native:platform_runtime.json": "licenses/debian/packages.json",
    ":licenses.txt": "licenses/README.txt",
    "@glib//:COPYING": "licenses/native/glib.COPYING",
    "@zlib//:LICENSE": "licenses/native/zlib.LICENSE",
    "@electron_platform_pciutils//:COPYING": "licenses/native/pciutils.COPYING",
    "@nss//:COPYING": "licenses/native/nss.COPYING",
    "@nspr//:LICENSE": "licenses/native/nspr.LICENSE",
})

_NOTICE_HASHES = {"licenses/debian/" + name + ".copyright": notice["sha256"] for name, notice in COPYRIGHTS.items()}

_NOTICE_HASHES.update({"licenses/common/" + name: notice["sha256"] for name, notice in COMMON_LICENSES.items()})

_SMOKE_FONT = "@electron_harfbuzz_upstream//:test/shape/data/in-house/fonts/7bbd3175734d5d291e1c15271ec0cbb97b626ebf.ttf"

_SMOKE_SOURCES = [
    "smoke/main.cjs",
    "smoke/preload.cjs",
    "smoke/index.html",
    "smoke/package.json",
]

_SMOKE_INPUTS = {":" + path: "electron/runtime_smoke/" + path.split("/")[-1] for path in _SMOKE_SOURCES}

_SMOKE_INPUTS.update({"//:" + path: "electron/" + path for path in [
    "package.json",
    "yarn.lock",
    "script/gn-asar.js",
]})

electron_node_project(
    name = "smoke_asar",
    srcs = _SMOKE_INPUTS,
    commands = [json.encode([
        "script/gn-asar.js",
        "--base",
        "$SOURCE_ROOT/electron/runtime_smoke",
        "--files",
    ] + ["$SOURCE_ROOT/electron/runtime_smoke/" + path.split("/")[-1] for path in _SMOKE_SOURCES] + [
        "--out",
        "$SOURCE_ROOT/electron/runtime-smoke.asar",
    ])],
    lock = "//source/native:electron_app_lock.json",
    logical_outputs = ["electron/runtime-smoke.asar"],
    npm_packages = DEFAULT_APP["packages"],
    out_files = ["runtime-smoke.asar"],
    project = "electron",
    target_compatible_with = _COMPATIBLE,
)

electron_runtime_archive(
    name = "runtime",
    archive = "electron-linux-x64.zip",
    exec_compatible_with = _COMPATIBLE,
    expected_sha256 = _NOTICE_HASHES,
    files = _FILES,
    host_abi = _HOST_ABI,
    libraries = _LIBRARIES,
    nss_integrity_modules = _NSS_INTEGRITY_MODULES,
    nss_integrity_tool = "//electron/private:nss_checksum",
    nss_parameters = "@nss//:cmd/shlibsign/shlibsign.c",
    report = "electron-linux-x64.elf.json",
    target_compatible_with = _COMPATIBLE,
)

py_test(
    name = "runtime_test",
    srcs = ["runtime_test.py"],
    args = [
        "$(rootpath :electron-linux-x64.zip)",
        str(len(RUNTIME_FILES)),
    ] + sorted(RUNTIME_FILES) + [
        "$(rootpath :runtime-smoke.asar)",
        "$(rootpath " + _SMOKE_FONT + ")",
        "$(rootpath //sdk:probe.node)",
    ],
    data = [
        ":electron-linux-x64.zip",
        ":runtime-smoke.asar",
        _SMOKE_FONT,
        "//sdk:probe.node",
    ],
    target_compatible_with = _COMPATIBLE,
)

cc_binary(
    name = "libfixture_base.so",
    srcs = ["fixture_base.c"],
    linkopts = ["-Wl,-soname,libfixture_base.so"],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = _COMPATIBLE,
)

cc_import(
    name = "fixture_base",
    shared_library = ":libfixture_base.so",
    target_compatible_with = _COMPATIBLE,
)

cc_binary(
    name = "libfixture_answer.so",
    srcs = ["fixture_answer.c"],
    linkopts = ["-Wl,-soname,libfixture_answer.so"],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = _COMPATIBLE,
    deps = [":fixture_base"],
)

cc_binary(
    name = "fixture_program",
    srcs = ["fixture_program.c"],
    linkopts = ["-ldl"],
    target_compatible_with = _COMPATIBLE,
)

electron_runtime_archive(
    name = "fixture_runtime",
    archive = "fixture-runtime.zip",
    exec_compatible_with = _COMPATIBLE,
    executables = ["electron"],
    files = {":fixture_program": "electron"},
    host_abi = _HOST_ABI,
    libraries = {
        ":libfixture_answer.so": "libfixture_answer.so",
        ":libfixture_base.so": "libfixture_base.so",
    },
    report = "fixture-runtime.elf.json",
    target_compatible_with = _COMPATIBLE,
)

electron_runtime_archive(
    name = "nss_fixture_runtime",
    archive = "nss-fixture-runtime.zip",
    exec_compatible_with = _COMPATIBLE,
    executables = ["electron"],
    files = {":fixture_program": "electron"},
    host_abi = _HOST_ABI,
    libraries = {label: name for name, label in _NATIVE_LIBRARIES.items() if label.startswith("@nss//") or label.startswith("@nspr//")},
    nss_integrity_modules = _NSS_INTEGRITY_MODULES,
    nss_integrity_tool = "//electron/private:nss_checksum",
    nss_parameters = "@nss//:cmd/shlibsign/shlibsign.c",
    report = "nss-fixture-runtime.elf.json",
    target_compatible_with = _COMPATIBLE,
)

cc_binary(
    name = "nss_runtime_probe",
    srcs = ["nss_runtime_probe.cc"],
    linkopts = ["-ldl"],
    target_compatible_with = _COMPATIBLE,
    deps = [
        "@nspr//:headers",
        "@nss//:headers",
    ],
)

py_test(
    name = "archive_test",
    srcs = ["archive_test.py"],
    args = ["$(rootpath " + label + ")" for label in [
        ":fixture-runtime.zip",
        ":fixture-runtime.elf.json",
        "@patchelf//:patchelf",
        ":fixture_program",
        ":libfixture_answer.so",
        ":libfixture_base.so",
        ":nss-fixture-runtime.zip",
        ":nss-fixture-runtime.elf.json",
        ":nss_runtime_probe",
    ]],
    data = [
        ":fixture-runtime.elf.json",
        ":fixture-runtime.zip",
        ":fixture_program",
        ":libfixture_answer.so",
        ":libfixture_base.so",
        ":nss-fixture-runtime.elf.json",
        ":nss-fixture-runtime.zip",
        ":nss_runtime_probe",
        "@patchelf",
    ],
    target_compatible_with = _COMPATIBLE,
    deps = ["//electron/private:runtime_archive_lib"],
)

_VERSION = RUNTIME_METADATA["producers"]["//electron:electron_version_file"]

electron_source_action(
    name = "generate_version",
    srcs = {
        "//:build/generate-template.py": _VERSION["script"][2:],
        "//:build/templates/version_string.tmpl": _VERSION["inputs"][0][2:],
        "@electron_platform_sources//:gen/electron/electron_version.args": _VERSION["inputs"][1][2:],
    },
    args = [arg.replace("$SOURCE_ROOT/", "../../") for arg in _VERSION["args"]],
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    logical_outputs = ["version"],
    out_files = ["version"],
    script = _VERSION["script"][2:],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

electron_artifact_file(
    name = "electron_license",
    src = "//:LICENSE",
    out = "LICENSE",
)

electron_artifact_file(
    name = "chromium_licenses",
    src = "//source/credits:about_credits.html",
    out = "LICENSES.chromium.html",
)

filegroup(
    name = "metadata",
    srcs = [
        ":LICENSE",
        ":LICENSES.chromium.html",
        ":version",
    ],
)

py_test(
    name = "metadata_test",
    srcs = ["metadata_test.py"],
    args = [
        "$(rootpath :version)",
        "$(rootpath :LICENSE)",
        "$(rootpath //:LICENSE)",
        "$(rootpath :LICENSES.chromium.html)",
        "$(rootpath //source/credits:about_credits.html)",
    ],
    data = [
        ":LICENSE",
        ":LICENSES.chromium.html",
        ":version",
        "//:LICENSE",
        "//source/credits:about_credits.html",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
