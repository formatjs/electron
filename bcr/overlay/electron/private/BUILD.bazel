load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "nss_checksum",
    srcs = ["nss_checksum.cc"],
    copts = ["-std=c++20"],
    linkstatic = True,
    local_defines = ["USE_UTIL_DIRECTLY"],
    deps = [
        "@nss//:freebl_static",
        "@nss//:gcm-aes-x86_c_lib",
        "@nss//:hw-acc-crypto-avx",
        "@nss//:hw-acc-crypto-avx2",
        "@nss//:intel-gcm-s_lib",
        "@nss//:intel-gcm-wrap_c_lib",
        "@nss//:nssutil3_link",
    ],
)

py_binary(
    name = "nss_integrity",
    srcs = ["nss_integrity.py"],
)

py_test(
    name = "nss_integrity_test",
    srcs = [
        "nss_integrity.py",
        "nss_integrity_test.py",
    ],
    imports = ["."],
    main = "nss_integrity_test.py",
)

py_binary(
    name = "copy_bindings",
    srcs = ["copy_bindings.py"],
)

exports_files(["webpack.cjs"])

py_binary(
    name = "torque",
    srcs = ["torque.py"],
)

py_binary(
    name = "run_source",
    srcs = ["run_source.py"],
    main = "run_source.py",
)

py_binary(
    name = "js2c",
    srcs = ["js2c.py"],
    main = "js2c.py",
)

py_binary(
    name = "original_fs",
    srcs = ["original_fs.py"],
)

py_binary(
    name = "node_config",
    srcs = ["node_config.py"],
)

py_binary(
    name = "webpack",
    srcs = ["webpack.py"],
)

py_binary(
    name = "source_action",
    srcs = ["source_action.py"],
)

py_binary(
    name = "artifact_file",
    srcs = ["artifact_file.py"],
)
