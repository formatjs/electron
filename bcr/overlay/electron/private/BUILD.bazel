load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//electron:execution_python.bzl", "electron_execution_python")
load("//electron:source_action.bzl", "electron_source_action")

package(default_visibility = ["//visibility:public"])

electron_execution_python(name = "execution_python")

py_library(
    name = "runtime_archive_lib",
    srcs = ["runtime_archive.py"],
)

cc_binary(
    name = "nss_checksum",
    srcs = ["nss_checksum.cc"],
    copts = ["-std=c++20"],
    linkstatic = True,
    local_defines = ["USE_UTIL_DIRECTLY"],
    deps = [
        "@nss//:freebl_static",
        "@nss//:gcm-aes-x86_c_lib",
        "@nss//:hw-acc-crypto-avx",
        "@nss//:hw-acc-crypto-avx2",
        "@nss//:intel-gcm-s_lib",
        "@nss//:intel-gcm-wrap_c_lib",
        "@nss//:nssutil3_link",
    ],
)

py_binary(
    name = "nss_integrity",
    srcs = ["nss_integrity.py"],
)

py_test(
    name = "nss_integrity_test",
    srcs = [
        "nss_integrity.py",
        "nss_integrity_test.py",
    ],
    imports = ["."],
    main = "nss_integrity_test.py",
)

py_binary(
    name = "copy_bindings",
    srcs = ["copy_bindings.py"],
)

exports_files(["webpack.cjs"])

py_binary(
    name = "torque",
    srcs = ["torque.py"],
)

py_binary(
    name = "run_source",
    srcs = ["run_source.py"],
    main = "run_source.py",
)

py_binary(
    name = "js2c",
    srcs = ["js2c.py"],
    main = "js2c.py",
)

py_binary(
    name = "original_fs",
    srcs = ["original_fs.py"],
)

py_binary(
    name = "node_config",
    srcs = ["node_config.py"],
)

py_binary(
    name = "webpack",
    srcs = [
        "npm_workspace.py",
        "webpack.py",
    ],
    imports = ["."],
)

py_binary(
    name = "source_action",
    srcs = ["source_action.py"],
)

py_binary(
    name = "artifact_file",
    srcs = ["artifact_file.py"],
)

exports_files([
    "artifact_file.py",
    "copy_files.py",
    "nss_integrity.py",
    "source_action.py",
    "runtime_archive.py",
    "source_tool.py",
])

cc_binary(
    name = "python_plugin_launcher",
    srcs = ["python_plugin_launcher.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "source_action_test",
    srcs = [
        "source_action.py",
        "source_action_test.py",
    ],
    args = [
        "$(rootpath :python_plugin_launcher)",
        "$(rootpath :python_plugin_fixture_output.json)",
    ],
    data = [
        "source_action_plugin_fixture.py",
        "source_action_plugin_helper.py",
        ":python_plugin_fixture_output.json",
        ":python_plugin_launcher",
    ],
    imports = ["."],
    target_compatible_with = ["@platforms//os:linux"],
)

electron_source_action(
    name = "python_plugin_fixture",
    srcs = {
        "source_action_plugin_fixture.py": "scripts/fixture.py",
        "source_action_plugin_helper.py": "scripts/helper.py",
    },
    args = [
        "generate",
        "result.json",
    ],
    literal_files = {
        "scripts/literal 世界.txt": "Declared literal 世界.\n",
        "third_party/fixture package/.bazel-license-input": "",
    },
    logical_outputs = ["result.json"],
    out_files = ["python_plugin_fixture_output.json"],
    python_tools = {"scripts/plugin": "scripts/fixture.py"},
    script = "scripts/fixture.py",
    target_compatible_with = ["@platforms//os:linux"],
)

py_binary(
    name = "node_project",
    srcs = [
        "node_project.py",
        "npm_workspace.py",
    ],
    imports = ["."],
)
