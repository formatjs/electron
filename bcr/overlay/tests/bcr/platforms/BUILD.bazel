# Match hermeticbuild/nodejs's pinned executor runtime.
platform(
    name = "buildbuddy_linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.31",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://mirror.gcr.io/library/buildpack-deps@sha256:7d9a7601d4e042e3578d7557186c745e03524bd3c751680618639db99d7e9ced",
    },
    visibility = ["//visibility:public"],
)
