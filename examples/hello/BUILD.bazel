load("//electron:defs.bzl", "electron_app", "electron_packages")

electron_app(
    name = "app",
    srcs = {
        "main.js": "main.js",
        "index.html": "index.html",
    },
    app_name = "hello-electron",
    main = "main.js",
    version = "1.0.0",
