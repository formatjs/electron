load("//electron:defs.bzl", "electron_app", "electron_package")

electron_app(
    name = "app",
    srcs = {
        "main.js": "main.js",
        "preload.js": "preload.js",
        "index.html": "index.html",
        "//source:isolated_bundle": "isolated_bundle.js",
    },
    app_name = "electron-bundle-smoke",
    main = "main.js",
    version = "1.0.0",
)

electron_package(
    name = "dist",
    app = ":app",
    bundle_id = "org.formatjs.bundle-smoke",
    product_name = "Hello",
    runtime = "@electron_runtime//:linux_amd64",
)
