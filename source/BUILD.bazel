load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//electron:source_rules.bzl", "electron_buildflags", "electron_fuses_generate", "electron_js2c", "electron_node_config", "electron_node_defines", "electron_original_fs", "electron_webpack")
load("//source/native:electron_buildflags.bzl", "ELECTRON_BUILD_FLAGS")
load("//source/native:fuses_flags.bzl", "DEBUG_FLAGS")
load("//source/native:node_inputs.bzl", "NODE_BUILTIN_INPUTS", "ORIGINAL_FS_INPUTS")
load("//source/native:webpack_inputs.bzl", "ISOLATED_RENDERER_INPUTS", "WEBPACK_PACKAGES")
load(":probes.bzl", "loop_probes")

electron_js2c(
    name = "embedder_javascript",
    srcs = {"builtin.js": "lib/electron/builtin.js"},
)

exports_files([
    "node.BUILD.bazel",
    "uv_sources.bzl",
    "upstream_pins.json",
    "boringssl-electron.patch",
    "patch_fingerprints.json",
])

alias(
    name = "electron",
    actual = "@electron_sources//:sources",
)

alias(
    name = "node",
    actual = "@electron_node_sources//:sources",
)

alias(
    name = "node_libuv",
    actual = "@electron_node_sources//:libuv",
)

cc_test(
    name = "loop_interrupt_test",
    srcs = ["loop_interrupt_test.c"],
    deps = [":node_libuv"],
)

loop_probes()

# Materialize patch provenance without analyzing the full source file inventory.
alias(
    name = "chromium_patches",
    actual = "@electron_chromium_sources//:electron_patches.json",
)

alias(
    name = "v8_patches",
    actual = "@electron_v8_sources//:electron_patches.json",
)

electron_fuses_generate(
    name = "fuses_generated",
    debug_flags = DEBUG_FLAGS,
)

filegroup(
    name = "fuses_sources",
    srcs = [":fuses_generated"],
    output_group = "sources",
)

filegroup(
    name = "fuses_headers",
    srcs = [":fuses_generated"],
    output_group = "headers",
)

cc_library(
    name = "electron_fuses",
    srcs = [":fuses_sources"],
    hdrs = [":fuses_headers"],
    includes = ["fuses_generated"],
    local_defines = ["NDEBUG=1"],
    deps = ["@electron_chromium_sources//:fuse_base_headers"],
)

cc_test(
    name = "fuses_test",
    srcs = ["fuses_test.cc"],
    deps = [":electron_fuses"],
)

cc_test(
    name = "crypto_compat_test",
    srcs = ["crypto_compat_test.cc"],
    deps = ["@electron_boringssl_sources//:ssl"],
)

filegroup(
    name = "dependency_patches",
    srcs = [
        "@electron_boringssl_sources//:LICENSE",
        "@electron_devtools_frontend_sources//:source_anchor",
        "@electron_ffmpeg_sources//:source_anchor",
        "@electron_mantle_sources//:source_anchor",
        "@electron_nan_sources//:source_anchor",
        "@electron_perfetto_sources//:source_anchor",
        "@electron_reactiveobjc_sources//:source_anchor",
        "@electron_reclient_configs_sources//:source_anchor",
        "@electron_sqlite_sources//:source_anchor",
        "@electron_squirrel_mac_sources//:source_anchor",
        "@electron_webrtc_sources//:source_anchor",
    ],
)

electron_node_defines(name = "node_defines")

electron_buildflags(
    name = "electron_buildflags",
    flags = ELECTRON_BUILD_FLAGS,
)

electron_webpack(
    name = "isolated_bundle",
    srcs = {"@electron_sources//:" + path: path for path in ISOLATED_RENDERER_INPUTS},
    buildflags = ":electron_buildflags",
    lock = "//source/native:webpack_lock.json",
    npm_packages = WEBPACK_PACKAGES,
    visibility = ["//visibility:public"],
)

electron_original_fs(
    name = "node_original_fs",
    srcs = {"@electron_node_sources//:" + path: path for path in ORIGINAL_FS_INPUTS},
)

electron_node_config(
    name = "node_config",
    settings = "//source/native:node_config_linux_amd64.json",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//tests:__pkg__"],
)

electron_js2c(
    name = "node_javascript",
    srcs = {("@electron_node_sources//deps/v8/tools:" + path.removeprefix("deps/v8/tools/") if path.startswith("deps/v8/tools/") else "@electron_node_sources//:" + path): path for path in NODE_BUILTIN_INPUTS},
    config = ":node_config",
    original_fs = ":node_original_fs",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//tests:__pkg__"],
)

cc_test(
    name = "node_defines_test",
    srcs = [
        "node_defines_test.cc",
        ":node_defines",
    ],
    includes = ["node_defines"],
)
